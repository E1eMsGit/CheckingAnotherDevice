<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:CheckingAnotherDevice.ViewModels"
             x:Class="CheckingAnotherDevice.Views.SettingsView">
    
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>

	<Grid RowDefinitions="* Auto" Margin="40 0">
		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
            <ItemsRepeater Items="{Binding AllModules}">
              <ItemsRepeater.ItemTemplate>
                <DataTemplate DataType="vm:RkPkuModuleViewModel">
			        <HeaderedContentControl Header="{Binding Name}" Background="Gray" Margin="0 20 0 0">
				        <StackPanel Spacing="10" Margin="10 0">
					        <TextBlock Text="Строка подключения" HorizontalAlignment="Center"/>
                            <TextBox Text="{Binding ConnectionString}" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </HeaderedContentControl>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
              <ItemsRepeater.Layout>
                <UniformGridLayout Orientation="Horizontal" ItemsStretch="Fill"  
                                   MaximumRowsOrColumns="5" MinColumnSpacing="20"/>
              </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>
        <Button Grid.Row="1" Command="{Binding SaveSettingsCommand}" Classes="SaveBtn"/>
    </Grid>
</UserControl>
